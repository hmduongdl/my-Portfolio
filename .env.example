# NeonSQL connection string
# Lấy từ: https://console.neon.tech → project → Connection string
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT secret — tạo bằng: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-64-char-string

# URL của frontend (dùng cho CORS, bỏ trailing slash)
# Local: http://localhost:5173
# Production: https://your-portfolio.vercel.app
FRONTEND_URL=http://localhost:5173
